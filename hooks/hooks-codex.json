{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${PLUGIN_ROOT}/cli/episodic-memory.mjs\" ]; then node \"${PLUGIN_ROOT}/cli/episodic-memory.mjs\" sync --background; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
